# Copie este arquivo para ".env" e preencha os valores. Nunca commite o .env.

# Código de acesso à página de Performance e à administração de integrações.
# Escolha uma senha forte só sua.
PERFORMANCE_ACCESS_CODE=

# Token secreto usado pela rotina agendada (cron) para chamar POST /api/social/fetch
# sem precisar de login de navegador. Gere um valor aleatório longo.
CRON_SECRET=

# URL pública do app depois de hospedado (sem barra no final).
# Necessária para os callbacks de OAuth do Instagram e do YouTube.
# Ex.: https://performance-prleofelix.onrender.com
PUBLIC_BASE_URL=

# ---------- Instagram (Meta for Developers) ----------
# Criar app em https://developers.facebook.com, produto "Instagram Graph API".
META_APP_ID=
META_APP_SECRET=

# ---------- YouTube (Google Cloud Console) ----------
# Criar projeto em https://console.cloud.google.com, ativar YouTube Data API v3
# e YouTube Analytics API, criar 1 API key e 1 credencial OAuth (tipo Web).
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NODE_ENV=development
